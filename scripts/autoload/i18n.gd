func _ready() -> void:
	for locale in MESSAGES:
		var trans: Translation = Translation.new()
		trans.locale = locale
		var messages: Dictionary = MESSAGES[locale]
		for key in messages:
			trans.add_message(key, messages[key])
		TranslationServer.add_translation(trans)

func locales() -> Array:
	return MESSAGES.keys()
